# Порт, на котором работает docker-compose (nginx)
KAISSA_PORT=8289

# Настройки PostgreSQL
POSTGRES_USER=kaissa
POSTGRES_PASSWORD=kaissa-secret-change-me
POSTGRES_DB=kaissa
DATABASE_URL=postgresql://kaissa:kaissa-secret-change-me@db:5432/kaissa?schema=public

# Секрет для подписи JWT
JWT_SECRET=

# Время на reconnect после смерти сервера до abandoned (сек)
ABANDON_SECONDS=20

# ID существующих постоянных аккаунтов администраторов через запятую. Имена прав не дают.
ADMIN_USER_IDS=


# Демо-партии ботов (по умолчанию включены, кроме NODE_ENV=test)
DEMO_ENABLED=true
