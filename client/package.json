{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:replay": "node --experimental-strip-types tests/replay.check.ts",
    "check:seo": "node --experimental-strip-types tests/seo.check.ts",
    "check:prerender": "node tests/crazyhouse-seo.check.mjs && node tests/public-seo.check.mjs",
    "check:unit": "vitest run tests"
  },
  "dependencies": {
    "@lichess-org/chessground": "^9.0.0",
    "chess.js": "^1.4.0",
    "pinia": "^2.3.0",
    "shared": "file:../shared",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
